+/* op1emu: which bits each queued store writes. Two slots of one parallel instruction may each write one
+   half of the same register (R0.H = R0.L + R6.L || R0.L = W[P0++P5]); whole-register stores would let
+   the second undo the first.  */
+static bu32 store_masks[20];
+
+static void
+queue_store_mask (SIM_CPU *cpu, bu32 *addr, bu32 val, bu32 mask)
+{
+  struct store *s = &BFIN_CPU_STATE.stores[BFIN_CPU_STATE.n_stores];
+  store_masks[BFIN_CPU_STATE.n_stores] = mask;
+  s->addr = addr;
+  s->val = val;
+  ++BFIN_CPU_STATE.n_stores;
 }
 
