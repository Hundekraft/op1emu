 queue_store (SIM_CPU *cpu, bu32 *addr, bu32 val)
 {
   struct store *s = &BFIN_CPU_STATE.stores[BFIN_CPU_STATE.n_stores];
+  store_masks[BFIN_CPU_STATE.n_stores] = 0xFFFFFFFF;
   s->addr = addr;
   s->val = val;
